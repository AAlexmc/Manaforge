<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- sin esto el sandbox corta TODA la red en release: la app descarga
	     sus bases (~36 MB) en el primer arranque y las carátulas al vuelo -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- ficheros elegidos por el usuario: copias de seguridad (guardar y
	     RESTAURAR), importar CSV, certificados y fondo de pantalla -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
